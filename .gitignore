# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Each project is a standalone Gradle build, so its wrapper must stay in version
# control: without the jar, ./gradlew cannot bootstrap on a fresh clone.
!gradle/wrapper/gradle-wrapper.jar

# Gradle build output and local caches, for every project folder
.gradle/
build/
out/

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

.idea

Claude.md